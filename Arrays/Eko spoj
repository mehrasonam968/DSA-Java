class Solution {
    int maxHeight(int[] arr, int m) {
        // code here
        int n = arr.length;
        int s =0;
        int sum = 0;
        for(int i = 0; i<n; i++){
            sum+= arr[i];
            
        }
        int e = sum;
        int ans =-1;
        while(s<= e){
            int mid = s+(e-s)/2;
            if(isValid(arr,m, mid )){
                ans = mid;
                s = mid+1;
            }
            else{
                e = mid-1;
            }
        }
        return ans;
    }
    static boolean isValid(int arr[] , int m, int maxHeight){
        int totalWood = 0;
        for(int i =0; i<arr.length;i++){
            if(arr[i]>maxHeight){
                int currentWood = arr[i]- maxHeight;
                totalWood+= currentWood;
            }
            if(totalWood>=m){
                return true;
        
            }
            
        }
        return false;
    }
}
