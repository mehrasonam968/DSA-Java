 class Solution {
public int splitArray(int[] nums, int k) {
int sum = 0;
for(int i =0; i<nums.length; i++){
sum+= nums[i];
}
    if(sum==0) return 0;
if(nums.length<k){
return -1;
}
int s =1;
int e = sum;
int ans= -1;
while(s<=e){
int m = s+(e-s)/2;
if(isValid(nums,k ,m)){
ans = m;
e = m-1;
}
else {
s = m+1;
}
}
return ans;
}
static boolean isValid(int nums[] , int k, int largestSum) {
int kCount = 1;
int sum = 0;
for(int i = 0; i<nums.length; i++){
if(sum + nums[i] <=largestSum){
sum+=nums[i];
}
else {
kCount++;
if(kCount >k){
return false;
}
if(nums[i]>largestSum){
return false;
}
else {
sum = 0;
sum+=nums[i];
}
}
}
return true;
}
 }
