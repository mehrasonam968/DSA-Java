class Solution {
    static boolean isValid(int arr[], int k , int min ){
        int count = 1;
        int lastPos =0;
        
        for(int i = 1; i<arr.length; i++ ){
        
            if(arr[i]-arr[lastPos] >= min){
                count++;
                lastPos=i;
            
            if(count==k){
                return true;
             }
            }
        }
        return false;
    }
    public int aggressiveCows(int[] arr, int k) {
        // code here
        int ans =-1;
        int n = arr.length;
        Arrays.sort(arr);
        int s = 1;
        int e = arr[n-1] - arr[0];
        while(s<=e){
            int m = s+(e-s)/2;
            if(isValid(arr, k , m)){
                ans = m;
                s = m+1;
            }
            else {
                e = m-1;
            }
        }
        return ans;
    }
}
